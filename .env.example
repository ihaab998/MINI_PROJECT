# ==========================================
# MyHealth — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit your actual '.env' file with real keys to GitHub.
# ==========================================

# Application Configuration
PROJECT_NAME="MyHealth — Universal Longitudinal Health Platform"
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Supabase Credentials (Optional for local development / Required for DB persistence)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=medical-records

# AI & LLM Engine Credentials
GEMINI_API_KEY=your-gemini-api-key-here

# Twilio WhatsApp Integration (Optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
